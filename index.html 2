<style>
  :root{
    --bg:#060607;
    --panel:#0d0d0f;
    --panel-hi:#141416;
    --line: rgba(255,255,255,0.09);
    --line-soft: rgba(255,255,255,0.05);
    --hi:#f8f8f8;
    --mid:#a3a3a8;
    --low:#616166;
    --red:#ff2138;
    --red-deep:#a30d1c;
    --red-soft: rgba(255,33,56,0.13);
    --red-line: rgba(255,33,56,0.4);
  }

  *{ box-sizing:border-box; }
  html{ background:var(--bg); }
  body{
    background:var(--bg);
    color:var(--hi);
    font-family:'Inter',sans-serif;
    font-weight:500;
    margin:0;
    position:relative;
    overflow-x:hidden;
  }

  ::selection{ background:var(--red); color:#050505; }
  ::-webkit-scrollbar{ width:8px; }
  ::-webkit-scrollbar-track{ background:var(--bg); }
  ::-webkit-scrollbar-thumb{ background:#242427; border-radius:6px; }

  :focus-visible{ outline:2px solid var(--red); outline-offset:3px; border-radius:3px; }

  h1,h2,h3,.display{ font-family:'Space Grotesk', sans-serif; font-weight:700; letter-spacing:-0.02em; }
  .mono{ font-family:'JetBrains Mono', monospace; }

  a{ color:inherit; text-decoration:none; }
  .container{ max-width:1180px; margin:0 auto; padding:0 24px; }

  /* ---------------- texture ---------------- */
  .grain{ position:fixed; inset:-100px; z-index:1; pointer-events:none; opacity:0.04; mix-blend-mode:overlay; }
  .grid-bg{
    position:absolute; inset:0; z-index:0; pointer-events:none;
    background-image: linear-gradient(rgba(255,33,56,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,33,56,0.07) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 75% 55% at 50% 0%, black 30%, transparent 85%);
  }
  .glow-blob{
    position:absolute; border-radius:50%; filter: blur(110px); pointer-events:none; z-index:0;
  }
  .scanline{
    position:absolute; left:0; right:0; height:1px; z-index:1; pointer-events:none;
    background: linear-gradient(90deg, transparent, var(--red), transparent);
    box-shadow: 0 0 18px 2px rgba(255,33,56,0.55);
    animation: scan 6s ease-in-out infinite;
  }
  @keyframes scan{ 0%{ top:8%; opacity:0;} 10%{opacity:1;} 50%{ top:82%; opacity:1;} 60%{opacity:0;} 100%{ top:82%; opacity:0;} }

  /* ---------------- scroll progress ---------------- */
  #progress{
    position:fixed; top:0; left:0; height:3px; width:0%;
    background: linear-gradient(90deg, var(--red-deep), var(--red));
    box-shadow: 0 0 12px rgba(255,33,56,0.7);
    z-index:100; transition: width 0.08s linear;
  }

  /* ---------------- nav ---------------- */
  header{
    position:fixed; top:0; left:0; right:0; z-index:90;
    background: rgba(6,6,7,0.72); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom:1px solid var(--line-soft);
  }
  .nav-inner{ height:74px; display:flex; align-items:center; justify-content:space-between; }
  .brand{ font-family:'Space Grotesk', sans-serif; font-size:1.1rem; font-weight:700; letter-spacing:-0.01em; }
  .brand span{ color:var(--red); }
  .nav-links a{ color:var(--mid); font-size:0.88rem; font-weight:600; transition: color .25s ease; position:relative; text-transform:uppercase; letter-spacing:0.04em; }
  .nav-links a:hover{ color:var(--hi); }
  .nav-links a::after{
    content:''; position:absolute; left:0; bottom:-5px; width:0; height:2px; background:var(--red);
    transition: width .3s ease;
  }
  .nav-links a:hover::after{ width:100%; }

  #menu-btn{ display:none; }
  #mobile-menu{ display:none; }
  @media (max-width: 767px){
    .nav-links{ display:none; }
    #menu-btn{ display:flex; }
    #mobile-menu.open{ display:flex; }
  }

  /* ---------------- buttons ---------------- */
  .btn{
    display:inline-flex; align-items:center; gap:10px; padding:15px 28px; border-radius:8px;
    font-size:0.9rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;
    transition: transform .25s ease, background .25s ease, border-color .25s ease, box-shadow .25s ease;
    will-change:transform;
  }
  .btn-primary{ background:var(--red); color:#0a0a0a; box-shadow: 0 8px 30px -8px rgba(255,33,56,0.55); }
  .btn-primary:hover{ background:#ff3c50; box-shadow: 0 10px 36px -6px rgba(255,33,56,0.75); }
  .btn-ghost{ border:1.5px solid var(--line); color:var(--hi); }
  .btn-ghost:hover{ border-color:var(--red); color:var(--red); }

  /* ---------------- eyebrow / chip ---------------- */
  .eyebrow{
    font-family:'JetBrains Mono', monospace; font-size:0.74rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--red); font-weight:600;
  }
  .chip{
    display:inline-flex; align-items:center; gap:9px; font-family:'JetBrains Mono',monospace; font-size:0.75rem; font-weight:600;
    padding:8px 15px; border-radius:100px; border:1px solid var(--red-line); color:var(--hi); background: rgba(255,33,56,0.06);
  }
  .pulse{ width:7px; height:7px; border-radius:99px; background:var(--red); box-shadow:0 0 0 0 rgba(255,33,56,.65); animation:pulse 2s infinite; }
  @keyframes pulse{ 70%{ box-shadow:0 0 0 7px rgba(255,33,56,0);} 100%{ box-shadow:0 0 0 0 rgba(255,33,56,0);} }

  /* ---------------- hero ---------------- */
  .hero-title{
    font-size: clamp(2.8rem, 6.8vw, 5.6rem);
    line-height:0.98; font-weight:800; letter-spacing:-0.03em; text-transform:uppercase;
  }
  .hero-title .accent{ color:var(--red); text-shadow: 0 0 40px rgba(255,33,56,0.4); }

  /* ---------------- marquee ---------------- */
  .marquee-wrap{
    border-top:1px solid var(--line); border-bottom:1px solid var(--line);
    overflow:hidden; white-space:nowrap; position:relative; background:var(--panel);
  }
  .marquee-track{ display:inline-flex; animation: scroll-x 30s linear infinite; }
  .marquee-wrap:hover .marquee-track{ animation-play-state: paused; }
  @keyframes scroll-x{ from{ transform:translateX(0);} to{ transform:translateX(-50%);} }
  .marquee-item{
    font-family:'JetBrains Mono',monospace; font-size:0.85rem; font-weight:700; color:var(--mid); text-transform:uppercase; letter-spacing:0.04em;
    padding:20px 28px; display:inline-flex; align-items:center; gap:28px;
  }
  .marquee-item .dot{ width:5px; height:5px; background:var(--red); }

  /* ---------------- reveal ---------------- */
  .reveal{ opacity:0; transform: translateY(24px); transition: opacity .8s cubic-bezier(.2,.7,.3,1), transform .8s cubic-bezier(.2,.7,.3,1); }
  .reveal.is-visible{ opacity:1; transform:none; }

  /* ---------------- spotlight bento cards ---------------- */
  .spot{
    position:relative; border:1px solid var(--line); background:var(--panel);
    border-radius:16px; overflow:hidden; isolation:isolate;
  }
  .spot::before{
    content:''; position:absolute; inset:0; z-index:0; opacity:0; transition:opacity .4s ease;
    background: radial-gradient(440px circle at var(--mx,50%) var(--my,50%), rgba(255,33,56,0.16), transparent 60%);
  }
  .spot:hover::before{ opacity:1; }
  .spot:hover{ border-color: var(--red-line); transform: translateY(-3px); }
  .spot{ transition: transform .35s ease, border-color .35s ease; }
  .spot > *{ position:relative; z-index:1; }

  .icon-badge{
    width:46px; height:46px; border-radius:10px; display:flex; align-items:center; justify-content:center;
    background:var(--red-soft); color:var(--red); border:1px solid var(--red-line);
  }

  /* ---------------- certification rows ---------------- */
  .cert-row{ border:1px solid var(--line); background:var(--panel); border-radius:12px; transition:border-color .3s ease, transform .3s ease; }
  .cert-row:hover{ border-color:var(--red-line); transform: translateX(3px); }

  /* ---------------- approach panel ---------------- */
  .approach-panel{
    position:relative; background: radial-gradient(ellipse 100% 100% at 20% 0%, var(--red-deep) 0%, #1a0507 42%, var(--bg) 78%);
    clip-path: polygon(0 3.5%, 100% 0, 100% 96.5%, 0 100%);
  }

  /* ---------------- stats ---------------- */
  .stat-num{ font-family:'Space Grotesk',sans-serif; font-weight:800; font-variant-numeric: tabular-nums; }

  .contact-title{ font-size: clamp(2.4rem, 6vw, 4.8rem); text-transform:uppercase; }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; }
    .reveal{ opacity:1; transform:none; }
    .marquee-track{ animation:none; }
    .scanline{ display:none; }
  }
</style>
</head>

